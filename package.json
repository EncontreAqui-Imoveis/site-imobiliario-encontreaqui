{
  "name": "site-imobiliario",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "test": "jest",
    "test:architecture": "node scripts/check-architecture-discipline.cjs",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:ci": "npm run lint && npm run test:architecture && npm run test:coverage",
    "test:e2e": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:4010 npm run build && playwright test",
    "test:e2e:headed": "cross-env NEXT_PUBLIC_API_URL=http://127.0.0.1:4010 npm run build && playwright test --headed",
    "ci:verify": "npm run test:ci && npm run build",
    "security:audit": "npm audit --audit-level=high",
    "test:sast": "cross-env PYTHONUTF8=1 semgrep scan --config auto src middleware.ts next.config.js"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "embla-carousel-autoplay": "^8.5.1",
    "embla-carousel-react": "^8.5.1",
    "firebase": "^12.10.0",
    "lucide-react": "^0.469.0",
    "next": "^16.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.1.6",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.27",
    "cross-env": "^10.1.0",
    "eslint": "^10.0.3",
    "eslint-config-next": "^16.1.6",
    "globals": "^17.4.0",
    "jest": "^30.3.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.57.0"
  }
}
